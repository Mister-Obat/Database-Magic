{
  "schema_version": "1.0.0",
  "paths": {
    "project_root": "..",
    "library_root": "../Cartes Magic",
    "ops_root": ".",
    "staging_root": "staging"
  },
  "scope": {
    "include_all_catalogued_types": true,
    "include_paper": true,
    "include_digital": true,
    "include_promos": true,
    "include_tokens": true,
    "include_variants": true,
    "include_unreleased": false,
    "deferred_set_ids": [],
    "explicit_exclusions": []
  },
  "sources": {
    "metadata_priority": [
      "scryfall_bulk",
      "mtgjson",
      "wizards_gallery",
      "gatherer",
      "smfcorp",
      "magiccorporation"
    ],
    "image_priority": [
      "local_exact",
      "scryfall",
      "wizards_gallery",
      "gatherer",
      "smfcorp",
      "magiccorporation"
    ],
    "enabled": {
      "scryfall_bulk": true,
      "mtgjson": false,
      "wizards_gallery": true,
      "gatherer": false,
      "smfcorp": false,
      "magiccorporation": false
    }
  },
  "image_policy": {
    "preferred_languages": [
      "fr",
      "en"
    ],
    "max_candidates_per_language": 3,
    "max_image_gets_per_language": 3,
    "minimum_short_side": 531,
    "minimum_long_side": 738,
    "output_width": 531,
    "output_height": 738,
    "fallback_rule": "largest_valid_examined_area_then_short_side_then_fr_then_source_priority",
    "resize_mode": "contain_no_crop_no_stretch",
    "create_placeholder": false
  },
  "network": {
    "connect_timeout_seconds": 15,
    "read_timeout_seconds": 45,
    "max_image_download_seconds": 120,
    "max_redirects": 2,
    "max_retries_per_image_get": 0,
    "max_image_bytes": 20971520,
    "respect_retry_after": true,
    "minimum_scryfall_interval_ms": 600,
    "minimum_gallery_interval_ms": 1000,
    "user_agent": "BibliothequeMagicLocal/1.0 (contact: local-library; respectful rate limits)"
  },
  "storage": {
    "minimum_free_bytes": 5368709120,
    "free_space_margin_percent": 20,
    "preserve_originals": true,
    "preserve_source_archives": true
  },
  "publication": {
    "keep_valid_generations": 2,
    "commit_marker": "publication.json",
    "publish_markdown_from_json": true,
    "lock_timeout_seconds": 0
  }
}
