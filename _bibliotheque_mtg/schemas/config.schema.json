{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/magic/config.schema.json",
  "title": "Configuration de la bibliothèque Magic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paths", "scope", "sources", "image_policy", "network", "storage", "publication"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["project_root", "library_root", "ops_root", "staging_root"],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "library_root": {"type": "string", "minLength": 1},
        "ops_root": {"type": "string", "minLength": 1},
        "staging_root": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["include_all_catalogued_types", "include_paper", "include_digital", "include_promos", "include_tokens", "include_variants", "include_unreleased", "deferred_set_ids"],
      "properties": {
        "include_all_catalogued_types": {"const": true},
        "include_paper": {"type": "boolean"}, "include_digital": {"type": "boolean"},
        "include_promos": {"type": "boolean"}, "include_tokens": {"type": "boolean"},
        "include_variants": {"type": "boolean"}, "include_unreleased": {"type": "boolean"},
        "deferred_set_ids": {"type": "array", "items": {"type": "string"}},
        "explicit_exclusions": {"type": "array", "items": {"type": "object", "required": ["provider_set_id", "reason"], "properties": {"provider_set_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      }
    },
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata_priority", "image_priority", "enabled"],
      "properties": {
        "metadata_priority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["scryfall_bulk", "mtgjson", "wizards_gallery", "gatherer", "smfcorp", "magiccorporation"]}},
        "image_priority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local_exact", "scryfall", "wizards_gallery", "gatherer", "smfcorp", "magiccorporation"]}},
        "enabled": {"type": "object", "additionalProperties": false, "required": ["scryfall_bulk", "mtgjson", "wizards_gallery", "gatherer", "smfcorp", "magiccorporation"], "properties": {"scryfall_bulk": {"type": "boolean"}, "mtgjson": {"type": "boolean"}, "wizards_gallery": {"type": "boolean"}, "gatherer": {"type": "boolean"}, "smfcorp": {"type": "boolean"}, "magiccorporation": {"type": "boolean"}}}
      }
    },
    "image_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred_languages", "max_candidates_per_language", "max_image_gets_per_language", "minimum_short_side", "minimum_long_side", "output_width", "output_height", "fallback_rule", "resize_mode", "create_placeholder"],
      "properties": {
        "preferred_languages": {"const": ["fr", "en"]},
        "max_candidates_per_language": {"const": 3}, "max_image_gets_per_language": {"const": 3},
        "minimum_short_side": {"const": 531}, "minimum_long_side": {"const": 738},
        "output_width": {"const": 531}, "output_height": {"const": 738},
        "fallback_rule": {"const": "largest_valid_examined_area_then_short_side_then_fr_then_source_priority"},
        "resize_mode": {"const": "contain_no_crop_no_stretch"},
        "create_placeholder": {"const": false}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["connect_timeout_seconds", "read_timeout_seconds", "max_image_download_seconds", "max_redirects", "max_retries_per_image_get", "max_image_bytes", "respect_retry_after", "minimum_scryfall_interval_ms", "minimum_gallery_interval_ms", "user_agent"],
      "properties": {
        "connect_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "read_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 180},
        "max_image_download_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_image_bytes": {"type": "integer", "minimum": 1024, "maximum": 104857600},
        "max_retries_per_image_get": {"const": 0}, "respect_retry_after": {"const": true},
        "minimum_scryfall_interval_ms": {"type": "integer", "minimum": 500},
        "minimum_gallery_interval_ms": {"type": "integer", "minimum": 1000},
        "user_agent": {"type": "string", "minLength": 10}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_free_bytes", "free_space_margin_percent", "preserve_originals", "preserve_source_archives"],
      "properties": {"minimum_free_bytes": {"type": "integer", "minimum": 5368709120}, "free_space_margin_percent": {"const": 20}, "preserve_originals": {"const": true}, "preserve_source_archives": {"const": true}}
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["keep_valid_generations", "commit_marker", "publish_markdown_from_json", "lock_timeout_seconds"],
      "properties": {"keep_valid_generations": {"type": "integer", "minimum": 2}, "commit_marker": {"const": "publication.json"}, "publish_markdown_from_json": {"const": true}, "lock_timeout_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}}
    }
  }
}
