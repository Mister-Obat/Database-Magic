{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/magic/catalogue.schema.json",
  "title": "Index JSON global de la bibliothèque Magic",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generation_id", "generated_at_utc", "source_snapshots", "scope", "completeness", "editions", "groups", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "generation_id": {"type": "string"}, "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_snapshots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["provider", "retrieved_at_utc", "sha256", "path"], "properties": {"provider": {"type": "string"}, "retrieved_at_utc": {"type": "string", "format": "date-time"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string"}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["as_of_date", "eligible_set_count", "deferred_set_count", "explicit_exclusions"], "properties": {"as_of_date": {"type": "string", "format": "date"}, "selection": {"type": "string"}, "eligible_set_count": {"type": "integer", "minimum": 0}, "deferred_set_count": {"type": "integer", "minimum": 0}, "explicit_exclusions": {"type": "array", "items": {"type": "object", "required": ["set_id", "reason"], "properties": {"set_id": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}}}},
    "completeness": {"type": "object", "additionalProperties": false, "required": ["metadata_state", "image_state", "editions_expected", "editions_indexed", "cards_expected", "cards_indexed", "faces_expected", "faces_with_valid_images", "unresolved_tasks"], "properties": {"metadata_state": {"enum": ["complete", "incomplete", "unknown"]}, "image_state": {"enum": ["complete", "incomplete", "unknown"]}, "editions_expected": {"type": "integer", "minimum": 0}, "editions_indexed": {"type": "integer", "minimum": 0}, "cards_expected": {"type": "integer", "minimum": 0}, "cards_indexed": {"type": "integer", "minimum": 0}, "faces_expected": {"type": "integer", "minimum": 0}, "faces_with_valid_images": {"type": "integer", "minimum": 0}, "unresolved_tasks": {"type": "integer", "minimum": 0}}},
    "editions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["local_id", "code", "names", "release_date", "category", "index_json", "index_md", "metadata_state", "image_state"], "properties": {"local_id": {"type": "string"}, "code": {"type": "string"}, "names": {"type": "object", "additionalProperties": {"type": "string"}}, "release_date": {"type": ["string", "null"], "format": "date"}, "category": {"type": "string"}, "index_json": {"type": "string"}, "index_md": {"type": "string"}, "metadata_state": {"enum": ["complete", "incomplete", "unknown"]}, "image_state": {"enum": ["complete", "incomplete", "unknown"]}}}},
    "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["folder_id", "display_name", "index_json", "index_md", "edition_ids"], "properties": {"folder_id": {"type": "string"}, "display_name": {"type": "string"}, "index_json": {"type": "string"}, "index_md": {"type": "string"}, "edition_ids": {"type": "array", "items": {"type": "string"}}}}},
    "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "object_id", "reason", "next_action"], "properties": {"kind": {"enum": ["missing_metadata", "unresolved_identity", "missing_image", "source_blocked", "unsupported_language"]}, "object_id": {"type": "string"}, "reason": {"type": "string"}, "next_action": {"type": "string"}}}}
  }
}
